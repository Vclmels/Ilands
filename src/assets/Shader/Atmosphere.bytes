Shader "Time of Day/Atmosphere" {
SubShader { 
 Tags { "QUEUE"="Transparent-470" "IGNOREPROJECTOR"="true" "RenderType"="Transparent" }
 Pass {
  Tags { "QUEUE"="Transparent-470" "IGNOREPROJECTOR"="true" "RenderType"="Transparent" }
  ZWrite Off
  Cull Front
  Fog { Mode Off }
  Blend SrcAlpha OneMinusSrcAlpha
Program "vp" {
SubProgram "gles " {
"!!GLES


#ifdef VERTEX

attribute vec4 _glesVertex;
attribute vec3 _glesNormal;
uniform highp mat4 glstate_matrix_mvp;
uniform highp vec3 TOD_LocalSunDirection;
uniform highp vec3 TOD_LocalMoonDirection;
uniform highp vec3 TOD_SunColor;
uniform highp vec3 TOD_MoonColor;
uniform highp vec4 TOD_AdditiveColor;
uniform highp vec3 TOD_CloudColor;
uniform highp vec4 TOD_MoonHaloColor;
uniform highp float _Contrast;
uniform highp float _Haziness;
uniform highp float _Horizon;
uniform highp float _Fogginess;
uniform highp vec2 _OpticalDepth;
uniform highp vec3 _OneOverBeta;
uniform highp vec3 _BetaRayleigh;
uniform highp vec3 _BetaRayleighTheta;
uniform highp vec3 _BetaMie;
uniform highp vec3 _BetaMieTheta;
uniform highp vec2 _BetaMiePhase;
uniform highp vec3 _BetaNight;
varying lowp vec4 xlv_COLOR;
void main ()
{
  vec3 tmpvar_1;
  tmpvar_1 = normalize(_glesNormal);
  lowp vec4 tmpvar_2;
  highp float tmpvar_3;
  tmpvar_3 = pow (clamp ((tmpvar_1.y + _Horizon), 0.001, 1.0), _Haziness);
  highp float tmpvar_4;
  tmpvar_4 = ((1.0 - tmpvar_3) * 190000.0);
  highp float tmpvar_5;
  tmpvar_5 = max (0.0, dot (-(tmpvar_1), TOD_LocalSunDirection));
  highp vec3 tmpvar_6;
  tmpvar_6 = ((1.0 - exp(
    -(((_BetaRayleigh * (tmpvar_4 + 
      (tmpvar_3 * (_OpticalDepth.x - tmpvar_4))
    )) + (_BetaMie * (tmpvar_4 + 
      (tmpvar_3 * (_OpticalDepth.y - tmpvar_4))
    ))))
  )) * ((TOD_SunColor * 
    (((1.0 + (tmpvar_5 * tmpvar_5)) * (_BetaRayleighTheta + (_BetaMieTheta / 
      pow ((_BetaMiePhase.x - (_BetaMiePhase.y * tmpvar_5)), 1.5)
    ))) * _OneOverBeta)
  ) + (TOD_MoonColor * _BetaNight)));
  tmpvar_2.xyz = tmpvar_6;
  tmpvar_2.w = (10.0 * max (max (tmpvar_2.x, tmpvar_2.y), tmpvar_2.z));
  highp vec4 tmpvar_7;
  tmpvar_7 = (tmpvar_2 + (TOD_MoonHaloColor * pow (
    max (0.0, dot (TOD_LocalMoonDirection, -(tmpvar_1)))
  , 10.0)));
  tmpvar_2 = tmpvar_7;
  highp vec4 tmpvar_8;
  tmpvar_8 = (tmpvar_2 + TOD_AdditiveColor);
  tmpvar_2 = tmpvar_8;
  highp vec3 tmpvar_9;
  tmpvar_9 = mix (tmpvar_2.xyz, TOD_CloudColor, vec3(_Fogginess));
  tmpvar_2.xyz = tmpvar_9;
  highp float tmpvar_10;
  tmpvar_10 = (tmpvar_2.w + _Fogginess);
  tmpvar_2.w = tmpvar_10;
  tmpvar_2.w = clamp (tmpvar_2.w, 0.0, 1.0);
  highp vec4 tmpvar_11;
  tmpvar_11 = pow (tmpvar_2, vec4(_Contrast));
  tmpvar_2 = tmpvar_11;
  gl_Position = (glstate_matrix_mvp * _glesVertex);
  xlv_COLOR = tmpvar_2;
}



#endif
#ifdef FRAGMENT

varying lowp vec4 xlv_COLOR;
void main ()
{
  gl_FragData[0] = xlv_COLOR;
}



#endif"
}
