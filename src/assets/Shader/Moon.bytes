Shader "Time of Day/Moon" {
Properties {
 _MainTex ("Base (RGB)", 2D) = "white" {}
 _Contrast ("Contrast", Float) = 0.75
}
SubShader { 
 Tags { "QUEUE"="Transparent-480" "IGNOREPROJECTOR"="true" "RenderType"="Transparent" }
 Pass {
  Tags { "QUEUE"="Transparent-480" "IGNOREPROJECTOR"="true" "RenderType"="Transparent" }
  ZWrite Off
  Fog { Mode Off }
Program "vp" {
SubProgram "gles " {
"!!GLES


#ifdef VERTEX

attribute vec4 _glesVertex;
attribute vec3 _glesNormal;
attribute vec4 _glesMultiTexCoord0;
uniform highp vec3 _WorldSpaceCameraPos;
uniform highp mat4 glstate_matrix_mvp;
uniform highp mat4 _World2Object;
uniform highp vec4 unity_Scale;
uniform highp float _Phase;
uniform highp vec4 _MainTex_ST;
varying lowp vec4 xlv_COLOR;
varying highp vec2 xlv_TEXCOORD0;
varying highp vec3 xlv_TEXCOORD1;
varying highp vec3 xlv_TEXCOORD2;
varying highp float xlv_TEXCOORD3;
void main ()
{
  lowp vec4 tmpvar_1;
  highp float tmpvar_2;
  tmpvar_2 = abs(_Phase);
  highp vec3 tmpvar_3;
  tmpvar_3.x = _Phase;
  tmpvar_3.y = -(tmpvar_2);
  tmpvar_3.z = -(tmpvar_2);
  highp vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = _WorldSpaceCameraPos;
  gl_Position = (glstate_matrix_mvp * _glesVertex);
  xlv_COLOR = tmpvar_1;
  xlv_TEXCOORD0 = ((_glesMultiTexCoord0.xy * _MainTex_ST.xy) + _MainTex_ST.zw);
  xlv_TEXCOORD1 = normalize(_glesNormal);
  xlv_TEXCOORD2 = normalize((normalize(
    (((_World2Object * tmpvar_4).xyz * unity_Scale.w) - _glesVertex.xyz)
  ) + (tmpvar_3 * 5.0)));
  xlv_TEXCOORD3 = (2.0 * (1.0 - tmpvar_2));
}



#endif
#ifdef FRAGMENT

uniform highp vec3 _Color;
uniform highp float _Contrast;
uniform sampler2D _MainTex;
varying highp vec2 xlv_TEXCOORD0;
varying highp vec3 xlv_TEXCOORD1;
varying highp vec3 xlv_TEXCOORD2;
varying highp float xlv_TEXCOORD3;
void main ()
{
  lowp vec4 tmpvar_1;
  lowp float shading_2;
  lowp vec3 color_3;
  color_3 = _Color;
  highp float tmpvar_4;
  tmpvar_4 = (xlv_TEXCOORD3 * max (0.0, dot (xlv_TEXCOORD1, xlv_TEXCOORD2)));
  shading_2 = tmpvar_4;
  lowp vec3 tmpvar_5;
  tmpvar_5 = (color_3 * (texture2D (_MainTex, xlv_TEXCOORD0).xyz * shading_2));
  color_3 = tmpvar_5;
  highp vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = pow (tmpvar_5, vec3(_Contrast));
  tmpvar_1 = tmpvar_6;
  gl_FragData[0] = tmpvar_1;
}



#endif"
}
SubProgram "gles3 " {
"!!GLES3#version 300 es


#ifdef VERTEX


in vec4 _glesVertex;
in vec3 _glesNormal;
in vec4 _glesMultiTexCoord0;
uniform highp vec3 _WorldSpaceCameraPos;
uniform highp mat4 glstate_matrix_mvp;
uniform highp mat4 _World2Object;
uniform highp vec4 unity_Scale;
uniform highp float _Phase;
uniform highp vec4 _MainTex_ST;
out lowp vec4 xlv_COLOR;
out highp vec2 xlv_TEXCOORD0;
out highp vec3 xlv_TEXCOORD1;
out highp vec3 xlv_TEXCOORD2;
out highp float xlv_TEXCOORD3;
void main ()
{
  lowp vec4 tmpvar_1;
  highp float tmpvar_2;
  tmpvar_2 = abs(_Phase);
  highp vec3 tmpvar_3;
  tmpvar_3.x = _Phase;
  tmpvar_3.y = -(tmpvar_2);
  tmpvar_3.z = -(tmpvar_2);
  highp vec4 tmpvar_4;
  tmpvar_4.w = 1.0;
  tmpvar_4.xyz = _WorldSpaceCameraPos;
  gl_Position = (glstate_matrix_mvp * _glesVertex);
  xlv_COLOR = tmpvar_1;
  xlv_TEXCOORD0 = ((_glesMultiTexCoord0.xy * _MainTex_ST.xy) + _MainTex_ST.zw);
  xlv_TEXCOORD1 = normalize(_glesNormal);
  xlv_TEXCOORD2 = normalize((normalize(
    (((_World2Object * tmpvar_4).xyz * unity_Scale.w) - _glesVertex.xyz)
  ) + (tmpvar_3 * 5.0)));
  xlv_TEXCOORD3 = (2.0 * (1.0 - tmpvar_2));
}



#endif
#ifdef FRAGMENT


layout(location=0) out mediump vec4 _glesFragData[4];
uniform highp vec3 _Color;
uniform highp float _Contrast;
uniform sampler2D _MainTex;
in highp vec2 xlv_TEXCOORD0;
in highp vec3 xlv_TEXCOORD1;
in highp vec3 xlv_TEXCOORD2;
in highp float xlv_TEXCOORD3;
void main ()
{
  lowp vec4 tmpvar_1;
  lowp float shading_2;
  lowp vec3 color_3;
  color_3 = _Color;
  highp float tmpvar_4;
  tmpvar_4 = (xlv_TEXCOORD3 * max (0.0, dot (xlv_TEXCOORD1, xlv_TEXCOORD2)));
  shading_2 = tmpvar_4;
  lowp vec3 tmpvar_5;
  tmpvar_5 = (color_3 * (texture (_MainTex, xlv_TEXCOORD0).xyz * shading_2));
  color_3 = tmpvar_5;
  highp vec4 tmpvar_6;
  tmpvar_6.w = 1.0;
  tmpvar_6.xyz = pow (tmpvar_5, vec3(_Contrast));
  tmpvar_1 = tmpvar_6;
  _glesFragData[0] = tmpvar_1;
}



#endif"
}
}
Program "fp" {
SubProgram "gles " {
"!!GLES"
}
SubProgram "gles3 " {
"!!GLES3"
}
}
 }
}
Fallback Off
}