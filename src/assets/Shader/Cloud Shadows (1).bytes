Shader "Time of Day/Cloud Shadows (1)" {
Properties {
 _NoiseTexture ("Noise Texture (A)", 2D) = "white" {}
}
SubShader { 
 Pass {
  Blend SrcAlpha OneMinusSrcAlpha
  Offset -1, -1
Program "vp" {
SubProgram "gles " {
"!!GLES


#ifdef VERTEX

attribute vec4 _glesVertex;
uniform highp mat4 glstate_matrix_mvp;
uniform highp vec3 TOD_LocalLightDirection;
uniform highp float _CloudSharpness;
uniform highp vec2 _CloudScale1;
uniform highp vec2 _CloudScale2;
uniform highp vec4 _CloudUV;
uniform highp mat4 _Projector;
varying highp vec4 xlv_TEXCOORD0;
varying highp float xlv_TEXCOORD1;
void main ()
{
  highp vec4 tmpvar_1;
  highp vec3 tmpvar_2;
  tmpvar_2 = -(TOD_LocalLightDirection);
  highp vec2 tmpvar_3;
  tmpvar_3 = (tmpvar_2.xz / pow ((tmpvar_2.y + 0.1), 0.75));
  highp vec4 tmpvar_4;
  tmpvar_4 = (_Projector * _glesVertex);
  highp vec2 tmpvar_5;
  tmpvar_5 = (0.5 + (tmpvar_4.xy / tmpvar_4.w));
  tmpvar_1.xy = (tmpvar_5 + ((tmpvar_3 + _CloudUV.xy) / _CloudScale1));
  tmpvar_1.zw = (tmpvar_5 + ((tmpvar_3 + _CloudUV.zw) / _CloudScale2));
  gl_Position = (glstate_matrix_mvp * _glesVertex);
  xlv_TEXCOORD0 = tmpvar_1;
  xlv_TEXCOORD1 = ((_CloudSharpness * 0.15) - (max (0.0, 
    (1.0 - _CloudSharpness)
  ) * 0.3));
}



#endif
#ifdef FRAGMENT

uniform highp float _Alpha;
uniform highp float _CloudDensity;
uniform sampler2D _NoiseTexture;
varying highp vec4 xlv_TEXCOORD0;
varying highp float xlv_TEXCOORD1;
void main ()
{
  lowp vec4 tmpvar_1;
  lowp float alpha_2;
  lowp vec4 tmpvar_3;
  tmpvar_3 = texture2D (_NoiseTexture, xlv_TEXCOORD0.xy);
  lowp vec4 tmpvar_4;
  tmpvar_4 = texture2D (_NoiseTexture, xlv_TEXCOORD0.zw);
  highp float tmpvar_5;
  tmpvar_5 = ((tmpvar_3.w * tmpvar_4.w) - (xlv_TEXCOORD1 * _CloudDensity));
  alpha_2 = tmpvar_5;
  lowp float tmpvar_6;
  tmpvar_6 = clamp (alpha_2, 0.0, 1.0);
  highp vec4 tmpvar_7;
  tmpvar_7.xyz = vec3(0.0, 0.0, 0.0);
  tmpvar_7.w = (tmpvar_6 * _Alpha);
  tmpvar_1 = tmpvar_7;
  gl_FragData[0] = tmpvar_1;
}



#endif"
}
SubProgram "gles3 " {
"!!GLES3#version 300 es


#ifdef VERTEX


in vec4 _glesVertex;
uniform highp mat4 glstate_matrix_mvp;
uniform highp vec3 TOD_LocalLightDirection;
uniform highp float _CloudSharpness;
uniform highp vec2 _CloudScale1;
uniform highp vec2 _CloudScale2;
uniform highp vec4 _CloudUV;
uniform highp mat4 _Projector;
out highp vec4 xlv_TEXCOORD0;
out highp float xlv_TEXCOORD1;
void main ()
{
  highp vec4 tmpvar_1;
  highp vec3 tmpvar_2;
  tmpvar_2 = -(TOD_LocalLightDirection);
  highp vec2 tmpvar_3;
  tmpvar_3 = (tmpvar_2.xz / pow ((tmpvar_2.y + 0.1), 0.75));
  highp vec4 tmpvar_4;
  tmpvar_4 = (_Projector * _glesVertex);
  highp vec2 tmpvar_5;
  tmpvar_5 = (0.5 + (tmpvar_4.xy / tmpvar_4.w));
  tmpvar_1.xy = (tmpvar_5 + ((tmpvar_3 + _CloudUV.xy) / _CloudScale1));
  tmpvar_1.zw = (tmpvar_5 + ((tmpvar_3 + _CloudUV.zw) / _CloudScale2));
  gl_Position = (glstate_matrix_mvp * _glesVertex);
  xlv_TEXCOORD0 = tmpvar_1;
  xlv_TEXCOORD1 = ((_CloudSharpness * 0.15) - (max (0.0, 
    (1.0 - _CloudSharpness)
  ) * 0.3));
}



#endif
#ifdef FRAGMENT


layout(location=0) out mediump vec4 _glesFragData[4];
uniform highp float _Alpha;
uniform highp float _CloudDensity;
uniform sampler2D _NoiseTexture;
in highp vec4 xlv_TEXCOORD0;
in highp float xlv_TEXCOORD1;
void main ()
{
  lowp vec4 tmpvar_1;
  lowp float alpha_2;
  lowp vec4 tmpvar_3;
  tmpvar_3 = texture (_NoiseTexture, xlv_TEXCOORD0.xy);
  lowp vec4 tmpvar_4;
  tmpvar_4 = texture (_NoiseTexture, xlv_TEXCOORD0.zw);
  highp float tmpvar_5;
  tmpvar_5 = ((tmpvar_3.w * tmpvar_4.w) - (xlv_TEXCOORD1 * _CloudDensity));
  alpha_2 = tmpvar_5;
  lowp float tmpvar_6;
  tmpvar_6 = clamp (alpha_2, 0.0, 1.0);
  highp vec4 tmpvar_7;
  tmpvar_7.xyz = vec3(0.0, 0.0, 0.0);
  tmpvar_7.w = (tmpvar_6 * _Alpha);
  tmpvar_1 = tmpvar_7;
  _glesFragData[0] = tmpvar_1;
}



#endif"
}
}
Program "fp" {
SubProgram "gles " {
"!!GLES"
}
SubProgram "gles3 " {
"!!GLES3"
}
}
 }
}
Fallback Off
}